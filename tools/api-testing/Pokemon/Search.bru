meta {
  name: Search
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/pokemon/search
  body: none
  auth: inherit
}

params:query {
  ~typesMatchAll: true
  ~types: fire,water
  ~name: poke ball
  ~supertype: pokemon
  ~subtypes: V
  ~subtypesMatchAll: true
  ~setId: swsh35
  ~rarity: Rare
  ~hpMin: 330
  ~page: 1
  ~pageSize: 20
  ~sortBy: hp
  ~sortOrder: desc
}

settings {
  encodeUrl: true
  timeout: 0
}
