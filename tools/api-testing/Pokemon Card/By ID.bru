meta {
  name: By ID
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/card/pokemon/:id
  body: none
  auth: inherit
}

params:path {
  id: swsh8-1
}

tests {
  // Following methods come from the folder TEST tab:
  // - loadPokemonSourceData
  // - convertAttacksToSourceFormat
  // - sortByName
  
  const idFromReq = req.getUrl().split('/').at(-1);
  const sourceData = loadPokemonSourceData()[idFromReq];
  
  test("Data Matches Source", function () {
    const body = res.getBody();
  
    // REQUIRED - id, images, legalities, name, number and supertype
    expect(body.id).to.equal(sourceData.id);
    expect(body.imageLow).to.equal(sourceData.images.small);
    expect(body.imageHigh).to.equal(sourceData.images.large);
    // legalities - compare keys
    const apiKeys = Object.keys(body.legalities).sort();
    expect(apiKeys).to.have.all.members(Object.keys(sourceData.legalities).sort());
    // legalities - compare values, case insensitive
    for (const key of apiKeys) {
      const apiValue = body.legalities[key]?.toLowerCase();
      const sourceValue = sourceData.legalities[key]?.toLowerCase();
      expect(apiValue).to.equal(sourceValue);
    }
    expect(body.name).to.equal(sourceData.name);
    expect(body.number).to.equal(sourceData.number);
    expect(body.supertype).to.equal(sourceData.supertype);
  
    // OPTIONAL - most cards will have a lot of these
    if (sourceData.subtypes) expect(body.subtypes).to.have.all.members(sourceData.subtypes);
    if (sourceData.hp) expect(body.hp).to.equal(sourceData.hp);
    if (sourceData.types) expect(body.types).to.have.all.members(sourceData.types);
    // TODO add evolvesTo and evolvesFrom
    if (sourceData.attacks) {
      const responseAttacks = convertAttacksToSourceFormat(body.attacks);
      expect(sortByName(responseAttacks)).to.deep.equal(sortByName(sourceData.attacks));
    }
    // TODO add weaknesses
    if (sourceData.retreatCost) expect(body.retreatCost).to.have.all.members(sourceData.retreatCost);
    if (sourceData.convertedRetreatCost) expect(body.convertedRetreatCost).to.equal(sourceData.convertedRetreatCost);
    if (sourceData.artist) expect(body.artistName).to.equal(sourceData.artist);
    if (sourceData.rarity) expect(body.rarityName).to.equal(sourceData.rarity);
    if (sourceData.flavorText) expect(body.flavorText).to.equal(sourceData.flavorText);
    if (sourceData.nationalPokedexNumbers)
      expect(body.pokedexNumbers).to.have.all.members(sourceData.nationalPokedexNumbers);
    if (sourceData.regulationMark) expect(body.regulationMark).to.equal(sourceData.regulationMark);
    // TODO add abilities
    // TODO add rules
    if (sourceData.rules) expect(body.rules).to.have.all.members(sourceData.rules);
    // TODO add resistance
    if (sourceData.level) expect(body.level).to.equal(sourceData.level);
    // TODO add ancientTrait
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
