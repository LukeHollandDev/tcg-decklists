meta {
  name: By ID
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/card/pokemon/:id
  body: none
  auth: inherit
}

params:path {
  id: bw1-5
}

tests {
  // Following methods come from the folder TEST tab:
  // - loadPokemonSourceData
  // - sortByName
  
  function sortByName(arr) {
    return arr.slice().sort((a, b) => a.name.localeCompare(b.name));
  }
  
  const idFromReq = req.getUrl().split('/').at(-1);
  const sourceData = loadPokemonSourceData()[idFromReq];
  const body = res.getBody();
  
  // ------------------ REQUIRED fields ------------------
  
  test("id should match", function () {
    expect(body.id).to.equal(sourceData.id);
  });
  
  test("images should match", function () {
    expect(body.imageLow).to.equal(sourceData.images.small);
    expect(body.imageHigh).to.equal(sourceData.images.large);
  });
  
  test("legalities keys and values should match case-insensitively", function () {
    const apiKeys = Object.keys(body.legalities).sort();
    const sourceKeys = Object.keys(sourceData.legalities).sort();
    expect(apiKeys).to.have.all.members(sourceKeys);
  
    for (const key of apiKeys) {
      const apiValue = body.legalities[key]?.toLowerCase();
      const sourceValue = sourceData.legalities[key]?.toLowerCase();
      expect(apiValue).to.equal(sourceValue);
    }
  });
  
  test("name, number, supertype should match", function () {
    expect(body.name).to.equal(sourceData.name);
    expect(body.number).to.equal(sourceData.number);
    expect(body.supertype).to.equal(sourceData.supertype);
  });
  
  // ------------------ OPTIONAL fields ------------------
  
  if (sourceData.subtypes) {
    test("subtypes should match", function () {
      expect(body.subtypes).to.have.all.members(sourceData.subtypes);
    });
  }
  
  if (sourceData.hp) {
    test("hp should match", function () {
      expect(body.hp).to.equal(sourceData.hp);
    });
  }
  
  if (sourceData.types) {
    test("types should match", function () {
      expect(body.types).to.have.all.members(sourceData.types);
    });
  }
  
  if (sourceData.evolvesTo) {
    test("evolvesTo should match", function () {
      expect(body.evolvesTo).to.have.all.members(sourceData.evolvesTo);
    });
  }
  
  if (sourceData.evolvesFrom) {
    test("evolvesFrom should match", function () {
      expect(body.evolvesFrom).to.have.all.members([sourceData.evolvesFrom]);
    });
  }
  
  if (sourceData.attacks) {
    test("attacks should match", function () {
      const normalizeAttack = attack => ({
        name: attack.name,
        cost: (attack.cost || []).slice().sort(),
        convertedEnergyCost: attack.convertedEnergyCost ?? attack.convertedCost ?? 0,
        damage: attack.damage || "",
        text: attack.text || ""
      });
  
      const responseAttacks = sortByName((body.attacks || []).map(normalizeAttack));
      const sourceAttacks = sortByName((sourceData.attacks || []).map(normalizeAttack));
  
      expect(responseAttacks.length).to.equal(sourceAttacks.length);
  
      for (let i = 0; i < sourceAttacks.length; i++) {
        const apiAttack = responseAttacks[i];
        const srcAttack = sourceAttacks[i];
        expect(apiAttack.name).to.equal(srcAttack.name);
        expect(apiAttack.cost).to.deep.equal(srcAttack.cost);
        expect(apiAttack.convertedEnergyCost).to.equal(srcAttack.convertedEnergyCost);
        expect(apiAttack.damage).to.equal(srcAttack.damage);
        expect(apiAttack.text).to.equal(srcAttack.text);
      }
    });
  }
  
  
  if (sourceData.weaknesses) {
    test("weaknesses should match", function () {
      expect(body.weaknesses).to.deep.equal(sourceData.weaknesses);
    });
  }
  
  if (sourceData.retreatCost) {
    test("retreatCost should match", function () {
      expect(body.retreatCost).to.have.all.members(sourceData.retreatCost);
    });
  }
  
  if (sourceData.convertedRetreatCost) {
    test("convertedRetreatCost should match", function () {
      expect(body.convertedRetreatCost).to.equal(sourceData.convertedRetreatCost);
    });
  }
  
  if (sourceData.artist) {
    test("artist should match", function () {
      expect(body.artistName).to.equal(sourceData.artist);
    });
  }
  
  if (sourceData.rarity) {
    test("rarity should match", function () {
      expect(body.rarityName).to.equal(sourceData.rarity);
    });
  }
  
  if (sourceData.flavorText) {
    test("flavorText should match", function () {
      expect(body.flavorText).to.equal(sourceData.flavorText);
    });
  }
  
  if (sourceData.nationalPokedexNumbers) {
    test("pokedexNumbers should match", function () {
      expect(body.pokedexNumbers).to.have.all.members(sourceData.nationalPokedexNumbers);
    });
  }
  
  if (sourceData.regulationMark) {
    test("regulationMark should match", function () {
      expect(body.regulationMark).to.equal(sourceData.regulationMark);
    });
  }
  
  if (sourceData.abilities) {
    test("abilities should match", function () {
      expect(sortByName(body.abilities)).to.deep.equal(sortByName(sourceData.abilities));
    });
  }
  
  if (sourceData.rules) {
    test("rules should match", function () {
      expect(body.rules).to.have.all.members(sourceData.rules);
    });
  }
  
  if (sourceData.resistances) {
    test("resistances should match", function () {
      expect(body.resistances).to.deep.equal(sourceData.resistances);
    });
  }
  
  if (sourceData.level) {
    test("level should match", function () {
      expect(body.level).to.equal(sourceData.level);
    });
  }
  
  if (sourceData.ancientTrait) {
    test("ancientTrait should match", function () {
      expect(body.ancientTrait.name).to.equal(sourceData.ancientTrait.name);
      expect(body.ancientTrait.text).to.equal(sourceData.ancientTrait.text);
    });
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
