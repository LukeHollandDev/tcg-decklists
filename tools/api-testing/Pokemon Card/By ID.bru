meta {
  name: By ID
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/pokemon/:id
  body: none
  auth: inherit
}

params:path {
  id: svp-78
}

tests {
  const path = require('path');
  const { getValidationTests } = require(path.join(bru.cwd(), 'lib/validators.js'));
  const { loadPokemonSourceData } = require(path.join(bru.cwd(), 'lib/load-data.js'));
  
  // Get card ID from request URL
  const idFromReq = req.getUrl().split('/').at(-1);
  
  // Load source data
  const sourceData = loadPokemonSourceData()[idFromReq];
  const apiCard = res.getBody();
  
  // Get all validation tests from the shared library
  const validationTests = getValidationTests(apiCard, sourceData, expect);
  
  // Run each test - this will show individual passing/failing tests in Bruno
  for (const { name, fn } of validationTests) {
    test(name, fn);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
